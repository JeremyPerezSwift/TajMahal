<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingVertical="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="12dp"
            app:cardCornerRadius="25dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#EEEEEE"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/imageReviewAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"/>
        </com.google.android.material.card.MaterialCardView>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReviewName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manon Garcia"
                android:textSize="12sp"
                android:fontFamily="@font/jakarta_semibold"/>

            <RatingBar
                android:id="@+id/ratingBarItem"
                style="@style/Widget.AppCompat.RatingBar.Indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:layout_marginTop="6dp"
                android:isIndicator="true"
                android:progressTint="@color/gold"
                android:progressBackgroundTint="#DADADA"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvReviewComment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since 1966"
        android:textSize="10sp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/jakarta_regular"/>

    <!-- Séparateur -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.75dp"
        android:layout_marginTop="20dp"
        android:background="#DADADA"/>
</LinearLayout>